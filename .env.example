# Intelligence RAG local development configuration.
# Copy this file to .env, then fill only the API keys required by the workflows you use.
# Do not commit .env, browser profiles, cookies, or credentials.
#
# 来源说明：以下变量均被本项目代码真实读取。
# - 多数经 backend/app/core/config.py（pydantic BaseSettings，读取根目录 .env）
# - 部分由 skills/video-crawler 或 scripts/* 脚本直接 os.environ 读取
# 标注「必填」的关键在对应工作流下若缺失会报错/功能不可用。

# -----------------------------------------------------------------------------
# Core API and local infrastructure
# -----------------------------------------------------------------------------
# APP_ENV=dev                              # config.py：运行环境
# API_HOST=0.0.0.0                          # config.py：监听的 API 地址
# API_PORT=8000                             # config.py：API 端口
# DATABASE_BROWSER_ENABLED=false            # config.py：开启只读 DB 浏览
# 默认 docker-compose.yml PostgreSQL 映射为 127.0.0.1:54329（与 config.py 默认一致）
# 这两个 URL 是后端读写各自使用的连接串（异步/同步），通常保持一致。
DATABASE_URL=postgresql+psycopg://intelligence:intelligence@127.0.0.1:54329/intelligence_rag
SYNC_DATABASE_URL=postgresql+psycopg://intelligence:intelligence@127.0.0.1:54329/intelligence_rag
# QDRANT_URL=http://localhost:6333          # config.py：向量库地址
# QDRANT_COLLECTION=content_chunks_bge_m3_v1 # config.py：向量集合名

# -----------------------------------------------------------------------------
# Semantic embedding（config.py）
# EMBEDDING_API_KEY 可选：未设置时复用 VLM_API_KEY。
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=

# -----------------------------------------------------------------------------
# General answer pipeline and worker tuning（config.py，默认值已注释）
# -----------------------------------------------------------------------------
# 问答检索的查询优化 Agent（app/agents/client.py）。fake=规则降级；deepseek=真实 LLM 优化，
# 会产出 entity_hints 等字段（需同时配置 DEEPSEEK_API_KEY）。
# LLM_PROVIDER=deepseek
# AGENT_TIMEOUT_SECONDS=20
# WORKER_POLL_INTERVAL_SECONDS=2

# -----------------------------------------------------------------------------
# VLM 摘要（供视频/多模态入库与摘要；config.py + video-crawler 脚本直接读取）
# -----------------------------------------------------------------------------
VLM_API_KEY=                                # 必填：VLM Key（video-crawler 缺失会终止）
# VLM_BASE_URL=https://api.siliconflow.cn/v1
# VLM_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct

# -----------------------------------------------------------------------------
# YouTube 视频采集（skills/video-crawler 脚本直接读取）
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=                            # 必填：YouTube Data API v3 Key（搜索/采集需要）
# 视频流下载必需走代理（香港/海外出口），否则 YouTube 返回 403。整机代理或仅本变量均可。
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897

# -----------------------------------------------------------------------------
# IEEE / 文献研究 worker（config.py + scripts/run_literature_worker.py）
# 需要：uv sync --extra literature；随后 uv run playwright install chromium
# 使用独立、不入库的浏览器 profile；先用 LITERATURE_HEADLESS=false 登录。
# -----------------------------------------------------------------------------
# LITERATURE_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=                            # 必填（文献摘要用 DeepSeek）
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# LITERATURE_BROWSER_PROFILE_DIR=~/.intelligence-rag/ieee-profile
# LITERATURE_HEADLESS=false
# LITERATURE_LOGIN_TIMEOUT_SECONDS=300
# LITERATURE_PDF_MAX_BYTES=52428800
# LITERATURE_FULLTEXT_MAX_CHARS=200000
# LITERATURE_RUN_ID=                       # scripts/run_literature_worker.py 指定续跑的 run_id

# -----------------------------------------------------------------------------
# Demo 种子与冒烟脚本（scripts/seed_demo.py、scripts/smoke_demo.sh）
# -----------------------------------------------------------------------------
# 默认只允许种子写入本地 DB；对外部/非本机地址强制需显式开启。
# ALLOW_NONLOCAL_DEMO_SEED=1
# smoke_demo.sh 访问 API 的基础地址与注入的种子载荷。
# API_BASE=http://localhost:8000
# SEED_KEY=unused-public-demo-seed-key
# SEED_JSON={\"kind\":\"documentation\",\"url\":\"https://example.com\"}

# -----------------------------------------------------------------------------
# 测试（可选；backend/tests、worker/tests 的 conftest.py）
# 开启后跑测试会清空/重建该测试库。
# TEST_DATABASE_URL=postgresql+psycopg://intelligence:intelligence@127.0.0.1:54329/test_intelligence_rag
# ALLOW_DESTRUCTIVE_TEST_DB=1