# Copy to repository root .env on the TARGET server. Never commit the filled file.
# Use a random hexadecimal password (e.g. openssl rand -hex 32); URL reserved chars need encoding.
POSTGRES_PASSWORD=
INTELLIGENCE_RAG_IMAGE=intelligence-rag-app:latest
COMPOSE_PROJECT_NAME=intelligence-rag
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000
COLLECTOR_DATA_DIR=./data/collector
MODEL_CACHE_DIR=./model-cache/huggingface

# Blank explicitly means direct access. Container localhost is NOT host localhost.
# Example: http://host.docker.internal:7897 (proxy must accept Docker bridge traffic)
HTTP_PROXY=
HTTPS_PROXY=

YOUTUBE_API_KEY=
VLM_API_KEY=
VLM_BASE_URL=https://api.siliconflow.cn/v1
VLM_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
QDRANT_COLLECTION=content_chunks_bge_m3_v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
BAIDU_QIANFAN_API_KEY=
