# Copy these values into an untracked .env file and fill credentials only on the target host.
DATABASE_URL=postgresql+psycopg://intelligence:intelligence@127.0.0.1:54329/intelligence_rag
SYNC_DATABASE_URL=postgresql+psycopg://intelligence:intelligence@127.0.0.1:54329/intelligence_rag
LITERATURE_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LITERATURE_BROWSER_PROFILE_DIR=~/.intelligence-rag/ieee-profile
LITERATURE_HEADLESS=false
