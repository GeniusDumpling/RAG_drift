# Intelligence RAG local development defaults
APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_DIST_DIR=frontend/dist

# PostgreSQL
DATABASE_URL=postgresql+psycopg://intelligence:intelligence@localhost:54329/intelligence_rag
SYNC_DATABASE_URL=postgresql+psycopg://intelligence:intelligence@localhost:54329/intelligence_rag

# Qdrant / vector index
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=content_chunks_v2

# Embeddings: project-standard 512-dimensional local BGE small zh
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512

# Query/extraction agent defaults
LLM_PROVIDER=fake
AGENT_TIMEOUT_SECONDS=20
WORKER_POLL_INTERVAL_SECONDS=2

# VLM settings for video demos. Set VLM_API_KEY locally; do not commit real keys.
VLM_BASE_URL=https://api.siliconflow.cn/v1
VLM_API_KEY=
VLM_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct
