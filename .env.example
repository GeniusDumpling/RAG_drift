# Intelligence RAG local development configuration.
# Copy this file to .env, then fill only the API keys required by the workflows you use.
# Do not commit .env, browser profiles, cookies, or credentials.

# -----------------------------------------------------------------------------
# Core API and local Docker Compose infrastructure
# -----------------------------------------------------------------------------
# APP_ENV=dev
# API_HOST=0.0.0.0
# API_PORT=8000
# DATABASE_BROWSER_ENABLED=false
# The default docker-compose.yml PostgreSQL mapping is 127.0.0.1:55432.
DATABASE_URL=postgresql+psycopg://intelligence:intelligence@127.0.0.1:55432/intelligence_rag
SYNC_DATABASE_URL=postgresql+psycopg://intelligence:intelligence@127.0.0.1:55432/intelligence_rag
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=content_chunks_v2

# -----------------------------------------------------------------------------
# Local semantic embedding (requires: uv sync --extra local-embeddings)
# -----------------------------------------------------------------------------
# EMBEDDING_PROVIDER=sentence-transformers
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_DIMENSION=512

# -----------------------------------------------------------------------------
# General answer pipeline and worker tuning (defaults shown)
# -----------------------------------------------------------------------------
# LLM_PROVIDER=fake
# AGENT_TIMEOUT_SECONDS=20
# WORKER_POLL_INTERVAL_SECONDS=2

# -----------------------------------------------------------------------------
# Optional video VLM summarization
# Required only for video analysis with --summarize-with-vlm or video ingestion.
# -----------------------------------------------------------------------------
# VLM_API_KEY=
# VLM_BASE_URL=https://api.siliconflow.cn/v1
# VLM_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct

# -----------------------------------------------------------------------------
# Optional IEEE literature research
# Requires: uv sync --extra literature, then: uv run playwright install chromium
# Use a dedicated, untracked browser profile. Start with HEADLESS=false to log in.
# -----------------------------------------------------------------------------
# LITERATURE_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# LITERATURE_BROWSER_PROFILE_DIR=~/.intelligence-rag/ieee-profile
# LITERATURE_HEADLESS=false
# LITERATURE_LOGIN_TIMEOUT_SECONDS=300
# LITERATURE_PDF_MAX_BYTES=52428800
# LITERATURE_FULLTEXT_MAX_CHARS=200000