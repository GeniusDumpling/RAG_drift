[Unit]
Description=RAG Parrot supplier pipeline

[Service]
Type=oneshot
WorkingDirectory=%h/projects/RAG_drift
EnvironmentFile=%h/projects/RAG_drift/.env
ExecStart=/usr/bin/flock --nonblock --verbose --conflict-exit-code=75 %t/rag-supplier-parrot.lock %h/projects/RAG_drift/.venv/bin/python -u %h/projects/RAG_drift/tools/supplier-information/pipeline.py --brand parrot
SuccessExitStatus=75
TimeoutStartSec=90min
TimeoutStopSec=30s
KillMode=control-group
Nice=10
StandardOutput=journal
StandardError=journal
