[Unit]
Description=Intelligence RAG discourse historical backfill container job
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rag
Group=rag
WorkingDirectory=/opt/intelligence-rag
Environment=JOB_TIMEOUT=20min
ExecStart=/bin/bash /opt/intelligence-rag/deploy/run-job.sh discourse-backfill
TimeoutStartSec=22min
TimeoutStopSec=60s
KillMode=mixed
StandardOutput=journal
StandardError=journal
